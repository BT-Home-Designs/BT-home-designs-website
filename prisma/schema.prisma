// Prisma schema for the BT Home Designs internal application.
//
// Phase 2: InternalUser (staff auth) only.
// Phase 3: adds the foundational Customer/Quote/Product/Pricing data model
// and the models backing the verified Roller Shade / Neolux matrix pricing
// engine (see lib/pricing/matrix-engine/). No quote UI, PDF generation, or
// customer-selling-price rules are wired up yet — see AGENTS.md / project
// history for the phased plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternalUserRole {
  ADMIN
  STAFF
}

/// Internal staff accounts for the protected /internal application.
/// Unrelated to the public site's visitors — this table has nothing to do
/// with customers or leads.
model InternalUser {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String
  role         InternalUserRole @default(STAFF)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  quotesCreated    Quote[]         @relation("QuoteCreatedBy")
  sellingPricesSet QuoteLineItem[] @relation("SellingPriceSetBy")

  @@map("internal_users")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DEPOSIT_PAID
  ORDERED
  IN_PRODUCTION
  READY_FOR_INSTALLATION
  INSTALLED
  PAID_IN_FULL
  CANCELLED
}

/// A quote-level discount (or deposit) is either a percentage of the
/// subtotal or a flat dollar amount — never both at once. Which numeric
/// field on Quote is authoritative depends on this type; see the field
/// comments on Quote below.
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DepositType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Customer-selling-price business rules have not been supplied yet
/// (locked as a separate, later decision from vendor/dealer cost). Every
/// selling-price field defaults to NOT_CONFIGURED with a null price — no
/// markup, margin, or vendor-retail passthrough is invented here.
enum SellingPriceStatus {
  NOT_CONFIGURED
  SET
}

enum ProductType {
  ROLLER_SHADE
  NEOLUX
  PLANTATION_SHUTTER
  DRAPERY
  EXTERIOR_SHADE
  FAUX_WOOD_BLIND
  OTHER
}

/// How a QuoteLineItem's price is calculated. Only MATRIX_PRICE has a real
/// implementation as of Phase 3 (lib/pricing/matrix-engine/) — the rest
/// exist as typed placeholders so the schema/UI don't have to be redesigned
/// once their business rules are supplied.
enum PricingStrategyType {
  MATRIX_PRICE
  SQUARE_FOOT
  FIXED_PRICE
  MANUAL_PRICE
  COMPOSITE_PRICE
}

/// The five verified Roller Shade / Neolux price groups. Locked — do not
/// rename or add to this list without an updated, re-verified source matrix.
enum PriceGroup {
  A
  B
  C
  D
  E
}

/// Outcome of one matrix-pricing calculation, persisted on PricingSnapshot.
/// SUCCESS is the only status with non-null pricing fields — see the
/// "STRICT ERROR CONTRACT" in lib/pricing/matrix-engine/engine.ts.
enum PricingStatus {
  SUCCESS
  OUT_OF_MATRIX_RANGE
  UNKNOWN_FABRIC
  INVALID_DIMENSIONS
  CONFIGURATION_ERROR
}

/// How a line item's customer selling price was determined. The first
/// four are automatic — computed from an internal cost using a
/// SellingPriceRule (see below); MANUAL means a staff member entered an
/// explicit price by hand (see QuoteLineItem.sellingPriceReason etc.).
/// Recorded on QuoteLineItem.sellingPriceMethod so a quote never shows a
/// price without knowing exactly how it was produced.
enum SellingPriceRuleType {
  MULTIPLIER
  MARKUP_PERCENT
  TARGET_MARGIN
  FIXED_AMOUNT
  MANUAL
  /// Computed directly by a SquareFootPricingRule (width x height / 144 x
  /// rate, plus arch/cutout charges) — there is no "cost" input to apply a
  /// multiplier/markup/margin to, so this is its own method rather than
  /// reusing one of the four cost-based types above.
  SQUARE_FOOT_FORMULA
}

/// Lifecycle for a configurable business-pricing record (a FixedPriceOption,
/// SquareFootPricingRule, etc.). PENDING_VERIFICATION means the number is
/// known/remembered but not yet confirmed as final — such a record must
/// never be picked up by an automatic pricing calculation, only ACTIVE
/// records are. INACTIVE is a deliberately retired record (e.g. superseded
/// by a new price) kept around for historical/audit reference.
enum BusinessPricingStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

// ---------------------------------------------------------------------------
// Customers & Quotes
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@map("customers")
}

model Quote {
  /// Internal, immutable database identity. Never shown to a customer and
  /// never reused as the human-facing quote number.
  id String @id @default(cuid())

  /// Human-facing, editable quote number (e.g. "Q-2026-0001"). Auto-generated
  /// at creation (see lib/quotes/quoteNumber.ts once quote-creation exists)
  /// but an authorized staff user may rename it later — nothing else in the
  /// schema references it, so renaming never breaks a relationship.
  quoteNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  quoteDate DateTime    @default(now())
  status    QuoteStatus @default(DRAFT)
  notes     String?

  /// Quote-level discount only in Phase 3. Line-item discounts are a later
  /// phase (see AGENTS.md / project history) — this schema doesn't block
  /// adding a parallel discount on QuoteLineItem when that's approved.
  discountType  DiscountType?
  /// Meaning depends on discountType: basis points (e.g. 1000 = 10.00%) when
  /// PERCENTAGE, cents when FIXED_AMOUNT. Null when discountType is null.
  discountValue Int?

  /// Basis points, e.g. 825 = 8.25%. Stored per-quote (not read from a global
  /// default at render time) so a historical quote's tax never changes if the
  /// business's default rate changes later.
  taxRateBps Int @default(0)

  depositType      DepositType?
  /// Meaning depends on depositType: basis points when PERCENTAGE, cents
  /// when FIXED_AMOUNT. Null when depositType is null.
  depositValue     Int?
  depositPaidCents Int          @default(0)

  createdById String?
  createdBy   InternalUser? @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems QuoteLineItem[]

  @@map("quotes")
}

model QuoteLineItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Explicit manual ordering within a quote — line items are added,
  /// duplicated, removed, and reordered freely, so this is a plain integer
  /// staff-controlled position, not a database identity.
  sortOrder Int @default(0)

  room             String?
  windowIdentifier String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  /// Actual entered dimensions, in inches. Decimal (not float) so the
  /// pricing engine's breakpoint comparisons (e.g. 36 vs 36.001) are never
  /// subject to binary floating-point error.
  width  Decimal? @db.Decimal(7, 3)
  height Decimal? @db.Decimal(7, 3)

  quantity Int @default(1)

  /// Plantation Shutter specific — ignored (should stay null) for every
  /// other product type. Not "forced" onto Roller Shade / Neolux items,
  /// which use fabricId/colorId below instead.
  archPanelCount  Int?
  doorCutoutCount Int?

  fabricId String?
  fabric   Fabric? @relation(fields: [fabricId], references: [id])

  colorId String?
  color   Color?  @relation(fields: [colorId], references: [id])

  mountType       String?
  controlType     String?
  motorization    String?
  remote          String?
  hub             String?
  solarCharger    String?
  /// Free-form hardware/option tags (e.g. "Fascia", "Cassette Valance").
  /// Not every product uses this — empty by default.
  hardwareOptions String[] @default([])
  installation    String?
  notes           String?

  pricingStrategyType PricingStrategyType?

  /// Customer selling price is a separate, not-yet-configured business
  /// decision from vendor/dealer cost (see PricingSnapshot below). Never
  /// auto-derived from dealer cost or vendor retail — see SellingPriceStatus.
  /// Stays NOT_CONFIGURED (sellingPriceCents null) until either a
  /// SellingPriceRule resolves for this item's product (automatic) or a
  /// staff member sets one manually — see lib/quotes/sellingPrice.ts.
  sellingPriceStatus SellingPriceStatus @default(NOT_CONFIGURED)
  sellingPriceCents  Int?

  /// Which of the 5 approaches produced sellingPriceCents — null when
  /// NOT_CONFIGURED. MANUAL is never silently replaced by an automatic
  /// recalculation; see lib/quotes/sellingPrice.ts.
  sellingPriceMethod SellingPriceRuleType?

  /// Populated only when sellingPriceMethod is one of the 4 automatic
  /// types — which SellingPriceRule computed this price, for audit.
  sellingPriceRuleId String?
  sellingPriceRule   SellingPriceRule? @relation(fields: [sellingPriceRuleId], references: [id], onDelete: SetNull)

  /// Who set the current selling price and when — populated for both
  /// automatic (rule application) and MANUAL entries. Never touches
  /// PricingSnapshot / dealer cost, which stay in their own audit trail.
  sellingPriceSetById String?
  sellingPriceSetBy   InternalUser? @relation("SellingPriceSetBy", fields: [sellingPriceSetById], references: [id], onDelete: SetNull)
  sellingPriceSetAt   DateTime?

  /// Optional note — required by the UI when sellingPriceMethod is MANUAL,
  /// optional/unused for automatic rule applications.
  sellingPriceReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingSnapshots PricingSnapshot[] @relation("LineItemSnapshotHistory")

  /// Points at the PricingSnapshot that reflects THIS line item's current
  /// fabric/width/height — i.e. the latest pricing attempt made since
  /// those inputs last changed, success or failure. Never left pointing at
  /// a stale snapshot from before an input change: repriceLineItemIfNeeded
  /// (lib/quotes/pricing.ts) updates this every time it creates a new
  /// snapshot, and clears it to null when pricing isn't even attempted
  /// (e.g. fabric/product/dimensions missing). The full history in
  /// `pricingSnapshots` above is never touched by this pointer moving —
  /// it only ever gains rows.
  currentPricingSnapshotId String?          @unique
  currentPricingSnapshot   PricingSnapshot? @relation("LineItemCurrentSnapshot", fields: [currentPricingSnapshotId], references: [id])

  /// Same append-only-history + current-pointer pattern as
  /// currentPricingSnapshot above, for Plantation Shutter (SQUARE_FOOT)
  /// pricing instead of matrix pricing — see SquareFootPriceSnapshot.
  squareFootSnapshots         SquareFootPriceSnapshot[] @relation("LineItemSquareFootSnapshotHistory")
  currentSquareFootSnapshotId String?                   @unique
  currentSquareFootSnapshot   SquareFootPriceSnapshot?  @relation("LineItemCurrentSquareFootSnapshot", fields: [currentSquareFootSnapshotId], references: [id])

  @@map("quote_line_items")
}

// ---------------------------------------------------------------------------
// Catalog: Vendors, Products, Fabrics, Colors
// ---------------------------------------------------------------------------

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  quoteLineItems   QuoteLineItem[]
  sellingPriceRule SellingPriceRule?

  @@map("vendors")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  productType ProductType

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  defaultPricingStrategyType PricingStrategyType

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fabrics               Fabric[]
  colors                Color[]
  quoteLineItems        QuoteLineItem[]
  sellingPriceRule      SellingPriceRule?
  squareFootPricingRule SquareFootPricingRule?

  @@map("products")
}

model Fabric {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Exact vendor/source spelling, preserved verbatim — including any
  /// apparent typos (e.g. "STUCKO BLACKOUT"). Never silently "corrected".
  sourceName String

  /// Derived, lookup-only form of sourceName (trim/whitespace/case
  /// normalized) — used for engine catalog matching, never as identity.
  /// The Fabric row's `id` is the stable identity; see
  /// lib/pricing/matrix-engine/fabricCatalog.ts.
  normalizedName String @unique

  /// Null for fabrics that don't use matrix pricing (not applicable yet —
  /// every fabric seeded in Phase 3 belongs to the verified A-E catalog).
  priceGroup PriceGroup?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteLineItems QuoteLineItem[]
  colors         Color[]

  @@unique([productId, sourceName])
  @@map("fabrics")
}

model Color {
  id   String @id @default(cuid())
  name String

  /// A color usually belongs to a specific fabric; some product families
  /// (e.g. shutters) may instead attach color directly to the product with
  /// no fabric in between. At most one of these is expected to be set —
  /// enforced at the application layer, not the database, since Prisma
  /// doesn't support a declarative "exactly one of" constraint here.
  fabricId String?
  fabric   Fabric? @relation(fields: [fabricId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteLineItems QuoteLineItem[]

  @@map("colors")
}

// ---------------------------------------------------------------------------
// Customer selling price
// ---------------------------------------------------------------------------

/// A configurable rule for automatically computing a line item's customer
/// selling price from its internal cost. No rows exist until BT Home
/// Designs supplies real values — see lib/quotes/sellingPrice.ts, which
/// treats an unresolved lookup as NOT_CONFIGURED rather than assuming any
/// default. Scoped to exactly one of productId / productType / vendorId
/// (enforced at the application layer, most-specific-wins when resolving:
/// product, then productType, then vendor).
model SellingPriceRule {
  id String @id @default(cuid())

  /// Product-specific rule — most specific scope.
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id])

  /// Applies to every product of this type that has no product-specific rule.
  productType ProductType? @unique

  /// Applies to every product from this vendor that has no more specific rule.
  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  /// One of MULTIPLIER / MARKUP_PERCENT / TARGET_MARGIN / FIXED_AMOUNT.
  /// MANUAL is a valid SellingPriceRuleType value but is never stored here
  /// — a manual price is a per-line-item override, not a reusable rule;
  /// see QuoteLineItem.sellingPriceMethod / sellingPriceReason.
  ruleType SellingPriceRuleType

  /// Selling price = cost x (multiplierBps / 10000). Set only when ruleType = MULTIPLIER.
  multiplierBps    Int?
  /// Selling price = cost x (1 + markupPercentBps / 10000). Set only when ruleType = MARKUP_PERCENT.
  markupPercentBps Int?
  /// Selling price = cost / (1 - targetMarginBps / 10000). Set only when ruleType = TARGET_MARGIN.
  targetMarginBps  Int?
  /// Selling price = fixedAmountCents, regardless of cost. Set only when ruleType = FIXED_AMOUNT.
  fixedAmountCents Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appliedToLineItems QuoteLineItem[]

  @@map("selling_price_rules")
}

/// Generic catalog of fixed-cost add-ons (e.g. a specific motorization kit,
/// remote, hub, solar charger, or installation charge) for the FIXED_PRICE
/// pricing strategy and COMPOSITE_PRICE line items.
///
/// Only `status: ACTIVE` options are ever picked up by an automatic
/// calculation (see lib/quotes/fixedPriceOptions.ts) — this is the
/// mechanism that keeps a PENDING_VERIFICATION price (e.g. an amount
/// previously described only as "approximate") from being silently
/// applied to a real quote. Editing costCents on an existing row only
/// affects future calculations: a line item already priced keeps its
/// frozen historical amount (see PricingSnapshot / SquareFootPriceSnapshot
/// for matrix/shutter pricing, and QuoteLineItem.sellingPriceCents for
/// selling price) — nothing here recomputes an old quote.
model FixedPriceOption {
  id        String                @id @default(cuid())
  name      String                @unique
  /// Free-form grouping for the UI to filter relevant options by field
  /// (e.g. "MOTORIZATION", "REMOTE", "SOLAR_CHARGER", "HUB",
  /// "INSTALLATION_BASE", "INSTALLATION_ADDON") — not a fixed enum, since
  /// new categories may be added later without a schema change.
  category  String
  costCents Int
  status    BusinessPricingStatus @default(ACTIVE)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("fixed_price_options")
}

/// Configures Plantation-Shutter-style square-foot customer pricing for one
/// Product: base = (width x height / 144) x ratePerSquareFootCents, plus a
/// flat charge per arch panel and per door cutout. Scoped to a single
/// product (not shared across product types) since a different SQUARE_FOOT
/// product later may have entirely different approved numbers. Only
/// `status: ACTIVE` rules are used by lib/quotes/shutterPricing.ts.
model SquareFootPricingRule {
  id String @id @default(cuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  ratePerSquareFootCents Int
  archChargeCents        Int @default(0)
  doorCutoutChargeCents  Int @default(0)

  status    BusinessPricingStatus @default(ACTIVE)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("square_foot_pricing_rules")
}

/// Installer minimum trip charge for a job under a configured shade count.
/// Seeded with BT Home Designs' approved numbers ($125 / under 5 shades)
/// but kept at PENDING_VERIFICATION — not INACTIVE, since the dollar
/// amount and shade-count threshold ARE approved — because how it
/// interacts with per-shade installation labor (replace vs. supplement)
/// is an open business decision. No code applies this rule to a quote
/// while it is not ACTIVE; see lib/quotes/installationPricing.ts.
model InstallationTripMinimumRule {
  id                       String                @id @default(cuid())
  minimumChargeCents       Int
  qualifiesUnderShadeCount Int
  status                   BusinessPricingStatus @default(PENDING_VERIFICATION)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@map("installation_trip_minimum_rules")
}

// ---------------------------------------------------------------------------
// Pricing audit
// ---------------------------------------------------------------------------

/// An immutable, append-only record of one pricing-engine calculation for a
/// QuoteLineItem. Never updated or overwritten — if a line item is
/// re-priced (fabric/size change, engine version bump, etc.), a NEW row is
/// created. A historical quote's displayed price therefore never silently
/// changes when the catalog or engine changes later. "The current price"
/// for a line item is whichever snapshot QuoteLineItem.currentPricingSnapshotId
/// points at (see that field) — not simply the most recent row here, since
/// a failed reprice attempt still becomes the newest row without being a
/// usable price.
model PricingSnapshot {
  id String @id @default(cuid())

  quoteLineItemId String
  quoteLineItem   QuoteLineItem @relation("LineItemSnapshotHistory", fields: [quoteLineItemId], references: [id], onDelete: Cascade)

  /// Back-reference for QuoteLineItem.currentPricingSnapshot — do not use
  /// this to find "the" line item's history; use quoteLineItemId above.
  currentForLineItem QuoteLineItem? @relation("LineItemCurrentSnapshot")

  /// Identifies which build of the pricing engine produced this snapshot
  /// (see lib/pricing/version.ts). Lets a future engine change be
  /// distinguished from a data change when auditing an old quote.
  pricingEngineVersion String

  pricingStatus PricingStatus

  /// Preserved verbatim, even on failure — see "STRICT ERROR CONTRACT" in
  /// lib/pricing/matrix-engine/engine.ts.
  sourceFabricName     String
  normalizedFabricName String

  productType ProductType?
  priceGroup  PriceGroup?

  /// Entered dimensions, always present when representable as a Decimal —
  /// null only for the (INVALID_DIMENSIONS) case of a non-finite input
  /// (NaN/Infinity), which cannot be stored as a SQL numeric value; the
  /// pricingStatus + warnings still explain why pricing failed.
  actualWidth  Decimal? @db.Decimal(7, 3)
  actualHeight Decimal? @db.Decimal(7, 3)

  /// Breakpoint values (always whole inches per the locked breakpoint
  /// lists), null on any non-SUCCESS result.
  selectedWidthTier  Int?
  selectedHeightTier Int?

  retailCents         Int?
  dealerMultiplierBps Int?
  dealerCostCents     Int?

  warnings String[] @default([])

  createdAt DateTime @default(now())

  @@map("pricing_snapshots")
}

/// Immutable, append-only record of one SQUARE_FOOT (Plantation Shutter)
/// customer-price calculation — the SquareFootPricingRule equivalent of
/// PricingSnapshot. Every applied rate/charge is frozen here at calculation
/// time, NOT read live from SquareFootPricingRule, so editing that rule's
/// costCents later never changes a quote that already has a snapshot.
/// "The current price" is whichever row QuoteLineItem.currentSquareFootSnapshotId
/// points at — never simply the newest row (a config becoming INACTIVE, or
/// a dimension change, can make pricing unavailable without deleting history).
model SquareFootPriceSnapshot {
  id String @id @default(cuid())

  quoteLineItemId String
  quoteLineItem   QuoteLineItem @relation("LineItemSquareFootSnapshotHistory", fields: [quoteLineItemId], references: [id], onDelete: Cascade)

  /// Back-reference for QuoteLineItem.currentSquareFootSnapshot.
  currentForLineItem QuoteLineItem? @relation("LineItemCurrentSquareFootSnapshot")

  /// Mirrors PricingStatus's fail-closed shape: SUCCESS is the only status
  /// with non-null price fields. CONFIGURATION_ERROR covers a missing/
  /// inactive SquareFootPricingRule; INVALID_DIMENSIONS mirrors the matrix
  /// engine's own validation (0/negative/NaN/Infinity).
  status PricingStatus

  /// Entered dimensions, preserved even on failure (same rationale as
  /// PricingSnapshot.actualWidth/actualHeight).
  actualWidth     Decimal? @db.Decimal(7, 3)
  actualHeight    Decimal? @db.Decimal(7, 3)
  archPanelCount  Int?
  doorCutoutCount Int?
  quantity        Int

  /// Frozen inputs from SquareFootPricingRule at calculation time — never
  /// re-read live from that (editable) row afterward.
  appliedRatePerSquareFootCents Int?
  appliedArchChargeCents        Int?
  appliedDoorCutoutChargeCents  Int?

  /// Exact square footage used (width x height / 144, NOT rounded before
  /// this division) — kept for audit even though only the cents amounts
  /// below are used for money math.
  squareFeet Decimal? @db.Decimal(12, 6)

  perUnitBaseCents           Int?
  archChargeTotalCents       Int?
  doorCutoutChargeTotalCents Int?
  /// (base + arch + cutout) x quantity — the actual customer selling-price
  /// contribution of this line item when status is SUCCESS.
  totalCents                 Int?

  createdAt DateTime @default(now())

  @@map("square_foot_price_snapshots")
}
