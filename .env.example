# Copy this file to .env.local for local development, or set these in
# your deployment platform's environment variables (e.g. Vercel Project
# Settings -> Environment Variables). Nothing in this file is a real
# credential — every value below must be supplied by the site owner.

# --- Lead delivery (required before the site can accept real leads) ---
# Resend (https://resend.com) API key, from your Resend dashboard.
# Used by both app/api/quote/route.ts (quote/contact forms) and
# app/api/warranty/route.ts (the /warranty service request form).
RESEND_API_KEY=

# The inbox that should receive quote/contact/warranty form notifications.
LEAD_NOTIFICATION_EMAIL=

# Optional. The sending domain mail.bthomedesigns.com is verified in
# Resend, so this defaults to "BT Home Designs Website
# <leads@mail.bthomedesigns.com>" if left unset. Only set this to
# override that default (e.g. for testing).
RESEND_FROM_EMAIL=

# --- Analytics (optional) ---
# Google Analytics 4 Measurement ID, format "G-XXXXXXXXXX".
# Leave unset and no analytics script loads at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site-verification token (from Search Console ->
# Settings -> Ownership verification -> HTML tag method -> copy just the
# "content" value). Leave unset and no verification tag is rendered.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Customer quotes & owner dashboard (/admin) ---
# The dashboard stays locked (sign-in disabled) until BOTH are set.
# Your dashboard password — 12+ characters. Choose your own; never commit it.
QUOTE_ADMIN_PASSWORD=
# Random string, 32+ characters, used to sign the dashboard login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTE_SESSION_SECRET=

# Postgres connection string for quotes, approvals, payments, and photos.
# REQUIRED on Vercel (its filesystem is not persistent). Any hosted Postgres
# works (e.g. Neon or Supabase, both available from the Vercel dashboard).
# Tables are created automatically on first use.
# Leave unset for local development: data is then kept in ./.data/quotes.
DATABASE_URL=

# Optional: where local (non-Postgres) quote data is stored. Defaults to ./.data/quotes
QUOTES_DATA_DIR=
